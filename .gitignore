# Home Assistant Add-on .gitignore

# Node.js
node_modules/
npm-debug.log
yarn-error.log
yarn.lock
# package-lock.json is deliberately committed: the image build uses `npm ci`
# so that two images tagged with the same add-on version contain the same
# dependency tree.

# Logs
*.log

# Build files
build/
dist/

# Temporary files
.tmp/
.temp/

# Environment variables
.env
.env.local
.env.*.local

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db

# Local add-on runtime state (mounted at /config in the container).
# Never commit it: this is where Claude and gh drop credential files.
/config/claude-config/
/config/options.json
