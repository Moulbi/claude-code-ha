#!/bin/bash

# persist-install — install packages that really survive a container restart.
#
# HOW THIS WORKS, AND WHY IT CHANGED IN 2.2.0
#
# Earlier versions installed a package with apk and then copied its executables
# from /usr/bin and its *.so files from /usr/lib into /data/packages. Everything
# else the package shipped was silently left behind, so anything that needs data
# files at runtime came back broken after a restart. python3 is the clearest
# case: it installs 715 files under /usr/lib, of which the standard library is
# .py, not .so. The copy therefore produced a python3 that fails at startup with
# "Could not find platform independent libraries".
#
# Instead of copying artefacts, we now persist the *inputs*: the list of
# packages you asked for (/data/packages/world) and apk's package cache
# (/data/packages/apk-cache). On every container start, run.sh replays the world
# file through apk, which produces a genuine, complete installation — data
# files, symlinks, triggers and dependencies included. Because the .apk files
# and the repository indexes are cached in /data, that replay also works with no
# network at all after the first install.

set -o pipefail

PERSIST_ROOT="${PERSIST_ROOT:-/data/packages}"
PERSIST_CACHE="${PERSIST_CACHE:-$PERSIST_ROOT/apk-cache}"
PERSIST_WORLD="${PERSIST_WORLD:-$PERSIST_ROOT/world}"
PERSIST_PYTHON="${PERSIST_PYTHON:-$PERSIST_ROOT/python}"
PERSIST_LEGACY_BIN="${PERSIST_LEGACY_BIN:-$PERSIST_ROOT/bin}"
APK_BIN="${APK_BIN:-apk}"

show_help() {
    cat << EOF
🔧 Persistent Package Installer

Install packages that survive container restarts and reboots.

USAGE:
    persist-install <package1> [package2] [...]
    persist-install --python <package1> [package2] [...]
    persist-install --remove <package1> [package2] [...]
    persist-install --restore
    persist-install --list
    persist-install --help

EXAMPLES:
    persist-install git htop          # Install system packages
    persist-install --python requests pandas
    persist-install --remove htop     # Stop reinstalling it on each start
    persist-install --list            # Show what is persisted

HOW IT PERSISTS:
    • Your package list lives in $PERSIST_WORLD
    • apk's download cache lives in $PERSIST_CACHE
    • On each container start, run.sh reinstalls the list from that cache,
      so packages come back complete — data files and dependencies included.
    • With the cache warm the replay takes about a second, and most packages
      also restore with the network down (not all: apk cannot resolve virtual
      providers offline).
    • Python packages go to a virtualenv in $PERSIST_PYTHON/venv, which lives
      on persistent storage directly and needs no replay.

NOTE:
    'ha', 'gh', 'git', 'jq', 'curl', 'node' and 'npm' already ship in the
    add-on image. You do not need to install them.
EOF
}

log()  { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }

ensure_dirs() {
    mkdir -p "$PERSIST_ROOT" "$PERSIST_CACHE" "$PERSIST_PYTHON" || return 1
    [ -f "$PERSIST_WORLD" ] || : > "$PERSIST_WORLD"
}

# Read the world file as a clean, de-duplicated, sorted package list.
read_world() {
    [ -f "$PERSIST_WORLD" ] || return 0
    grep -vE '^\s*(#|$)' "$PERSIST_WORLD" 2>/dev/null | tr -d '\r' | sort -u
}

write_world() {
    sort -u > "$PERSIST_WORLD.tmp" && mv "$PERSIST_WORLD.tmp" "$PERSIST_WORLD"
}

world_add() {
    { read_world; printf '%s\n' "$@"; } | grep -vE '^\s*$' | write_world
}

world_remove() {
    local keep pkg
    keep=$(read_world)
    for pkg in "$@"; do
        keep=$(printf '%s\n' "$keep" | grep -vxF "$pkg")
    done
    printf '%s\n' "$keep" | grep -vE '^\s*$' | write_world
}

# Install through apk with the persistent cache.
#
# The cache makes the normal path fast (a warm restore of python3 and its 25
# dependencies takes about a second) and lets most packages reinstall with the
# network down. It is not a universal offline guarantee: apk masks virtual
# providers under --no-network, so a package pulled in through one — python3
# needs python3-pyc, for example — still needs connectivity. The fallback
# therefore retries package by package, so one unresolvable entry cannot block
# everything else.
apk_install() {
    if "$APK_BIN" add --no-progress --cache-dir "$PERSIST_CACHE" "$@"; then
        return 0
    fi

    warn "⚠️  apk failed (no network?); retrying from the persistent cache, one package at a time"

    local pkg failed=0
    for pkg in "$@"; do
        if "$APK_BIN" add --no-progress --cache-dir "$PERSIST_CACHE" --no-network "$pkg"; then
            warn "   ✓ $pkg restored from cache"
        else
            warn "   ✗ $pkg needs connectivity (not fully cached)"
            failed=1
        fi
    done
    return "$failed"
}

install_system_packages() {
    if [ "$#" -eq 0 ]; then
        warn "❌ No system packages specified"
        return 1
    fi

    ensure_dirs || { warn "❌ Cannot write to $PERSIST_ROOT"; return 1; }

    log "📦 Installing: $*"
    if ! apk_install "$@"; then
        warn "❌ Failed to install: $*"
        warn "   Nothing was added to the persistent package list."
        return 1
    fi

    world_add "$@"
    log ""
    log "✅ Installed and recorded in $PERSIST_WORLD"
    log "💡 Reinstalled automatically on every restart, complete with their data"
    log "   files and dependencies — served from the cache in $PERSIST_CACHE."
}

remove_packages() {
    if [ "$#" -eq 0 ]; then
        warn "❌ No packages specified"
        return 1
    fi

    ensure_dirs || return 1
    world_remove "$@"
    log "🗑️  Removed from the persistent list: $*"
    log "   They stay installed in the running container until the next restart."
    log "   Run 'apk del $*' to drop them right now."
}

# Replay the world file. Called by run.sh at startup and by --restore.
restore_packages() {
    local packages
    ensure_dirs || return 1

    packages=$(read_world)
    if [ -z "$packages" ]; then
        log "No persistent packages recorded."
        return 0
    fi

    log "♻️  Restoring persistent packages: $(printf '%s' "$packages" | tr '\n' ' ')"
    # shellcheck disable=SC2086  # deliberate word splitting: one package per word
    if apk_install $packages; then
        log "✅ Persistent packages restored"
        return 0
    fi

    warn "⚠️  Could not restore every persistent package. The add-on continues;"
    warn "   run 'persist-install --restore' once connectivity is back."
    return 1
}

install_python_packages() {
    if [ "$#" -eq 0 ]; then
        warn "❌ No Python packages specified"
        return 1
    fi

    ensure_dirs || return 1

    if [ ! -x "$PERSIST_PYTHON/venv/bin/python" ]; then
        log "📥 Creating the persistent Python virtual environment..."
        if ! command -v python3 >/dev/null 2>&1; then
            install_system_packages python3 py3-pip || return 1
        fi
        if ! python3 -m venv "$PERSIST_PYTHON/venv"; then
            warn "❌ Could not create the virtual environment"
            return 1
        fi
    fi

    # shellcheck disable=SC1091
    . "$PERSIST_PYTHON/venv/bin/activate" || return 1

    log "🐍 Installing Python packages: $*"
    pip install --upgrade pip -q
    if ! pip install "$@"; then
        warn "❌ pip failed"
        return 1
    fi

    log ""
    log "✅ Installed into $PERSIST_PYTHON/venv"
    log "💡 The virtualenv lives on persistent storage, so it survives restarts as-is."
}

list_packages() {
    log "=== 📦 Persistent Packages ==="
    log ""
    log "🔧 System packages (replayed on every start, from $PERSIST_WORLD):"
    local packages
    packages=$(read_world)
    if [ -n "$packages" ]; then
        printf '%s\n' "$packages" | sed 's/^/  • /'
    else
        log "  (none)"
    fi
    log ""

    log "🐍 Python packages ($PERSIST_PYTHON/venv):"
    if [ -x "$PERSIST_PYTHON/venv/bin/pip" ]; then
        "$PERSIST_PYTHON/venv/bin/pip" list --format=columns 2>/dev/null | tail -n +3 | sed 's/^/  • /'
    else
        log "  (virtual environment not created)"
    fi
    log ""

    if [ -d "$PERSIST_LEGACY_BIN" ] && [ -n "$(ls -A "$PERSIST_LEGACY_BIN" 2>/dev/null)" ]; then
        log "⚠️  Legacy copied binaries still present in $PERSIST_LEGACY_BIN:"
        ls -1 "$PERSIST_LEGACY_BIN" | sed 's/^/  • /'
        log "   These are leftovers from the pre-2.2.0 copy-based mechanism. They were"
        log "   incomplete by design (data files were never copied) and now sit at the"
        log "   END of PATH so a real installation always wins. Reinstall anything you"
        log "   still need with 'persist-install <package>', then delete that directory."
        log ""
    fi

    log "💾 Cache: $(du -sh "$PERSIST_CACHE" 2>/dev/null | cut -f1 || echo 0B) in $PERSIST_CACHE"
}

main() {
    if [ ! -d "$(dirname "$PERSIST_ROOT")" ]; then
        warn "❌ $(dirname "$PERSIST_ROOT") not found; run this inside the add-on"
        return 1
    fi

    case "${1:-}" in
        --help|-h|help|"") show_help ;;
        --list|-l|list)    list_packages ;;
        --restore|restore) restore_packages ;;
        --remove|-r|remove) shift; remove_packages "$@" ;;
        --python|-p|python) shift; install_python_packages "$@" ;;
        --ha-cli|ha-cli)
            log "ℹ️  The Home Assistant CLI already ships in the add-on image at /usr/bin/ha."
            log "   Installing a second copy is unnecessary and risks shadowing a newer one."
            log "   Run 'ha --help' to use it."
            ;;
        *) install_system_packages "$@" ;;
    esac
}

main "$@"
